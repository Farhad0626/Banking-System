# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=banking_system
DB_USER=banking_user
DB_PASSWORD=changeme

# Login / Rate limiting 
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_LOCK_DURATION_SECONDS=60

# Account business rules
SAVINGS_INTEREST_RATE=0.05
CHECKING_WITHDRAWAL_LIMIT=5000
TERM_DEPOSIT_INTEREST_RATE=0.08
TERM_DEPOSIT_EARLY_WITHDRAWAL_FEE=0.02

# Password policy
PASSWORD_STRICT_MODE=false

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log

# Security
BCRYPT_ROUNDS=12

# Integration tests
TEST_DB_NAME=banking_system_test